<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:views="using:PathFinder.Views"
             x:Class="PathFinder.Views.NavigatorView"
             x:DataType="vm:NavigatorViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <!-- Cloud Navigator, the view from the clouds. Bindings are the contract.
         Read-only on purpose: the navigator can't click anything, they talk. -->
    <!-- Layout switches with the window width (see the code-behind): side by side when wide, map above the panel when narrow. -->
    <Grid x:Name="Root" Margin="16" ColumnDefinitions="*,340">
        <!-- Whole map: the driver's trail (yellow), start (green ring), destination (red ring), driver (blue dot + arrow) -->
        <views:RouteMap x:Name="MapView" Grid.Column="0" ClipToBounds="True" Reveal="False" Map="{Binding Map}" Routes="{Binding Routes}" Markers="{Binding Markers}" MinHeight="200"/>

        <ScrollViewer x:Name="Panel" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding RoleBanner}" FontSize="24" FontWeight="Bold" Foreground="#FFC83D" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding TimeLeft}" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{Binding DriverStatus}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Distance}" Opacity="0.8"/>

                <!-- What the driver's buttons say right now (read-only), left to right -->
                <Border Background="#2a2560" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="The driver's exits:" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding DriverExits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" FontSize="16"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- How to play: last, so the exits stay visible when the panel is short -->
                <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Opacity="0.8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
