<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             xmlns:views="using:PathFinder.Views"
             x:Class="PathFinder.Views.ResultsView"
             x:DataType="vm:ResultsViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>
    
    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <!-- Side by side when wide, results under the map when narrow (see ResponsiveLayout) -->
    <Grid x:Name="Root" Margin="16" ColumnDefinitions="*,380">
        <!-- Map with everyone's route and the best route -->
        <views:RouteMap Grid.Column="0" ClipToBounds="True" Map="{Binding Map}" Routes="{Binding MapRoutes}" MinHeight="200"/>

        <!-- Results, with each row's colour matching that player's line -->
        <ScrollViewer x:Name="Panel" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Left" views:Motion.PopDelay="0"/>
            <!-- Rows slide in one by one while the routes race on the map -->
            <ItemsControl ItemsSource="{Binding Rows}" views:Motion.Stagger="110" views:Motion.StaggerStart="350">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ResultRow">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                            <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Top" Margin="0,4,8,0"
                                    Background="{Binding Color}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Cloud Navigator only: how the team's score was worked out (hidden otherwise) -->
            <TextBlock Text="{Binding ScoreBreakdown}" TextWrapping="Wrap" Opacity="0.9"
                       IsVisible="{Binding ScoreBreakdown, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Grid ColumnDefinitions="Auto,*" views:Motion.EnterDelay="1800">
                <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Top" Margin="0,4,8,0"
                        Background="{Binding BestRouteSwatch}"/>
                <TextBlock Grid.Column="1" Text="{Binding BestRoute}" Opacity="0.8" TextWrapping="Wrap"/>
            </Grid>
            <StackPanel Spacing="6" Margin="0,8,0,0" views:Motion.EnterDelay="2200">
                <TextBlock Text="{Binding TimeLeft}" FontSize="18"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding TimeFraction}" Foreground="#4FC3F7"
                             Height="4" MinHeight="4">
                    <ProgressBar.Transitions>
                        <Transitions><DoubleTransition Property="Value" Duration="0:0:0.25"/></Transitions>
                    </ProgressBar.Transitions>
                </ProgressBar>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
