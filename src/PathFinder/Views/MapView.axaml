<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:mapsui="using:Mapsui.UI.Avalonia"
             x:Class="PathFinder.Views.MapView"
             x:DataType="vm:MapViewModel"
             Focusable="True"
             Background="Black">

    <UserControl.Styles>
        <!-- Overlay panels float over the imagery, so they get a dark translucent backing. -->
        <Style Selector="Border.overlay">
            <Setter Property="Background" Value="#B0202020"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="12"/>
        </Style>
        <Style Selector="Border.overlay TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.map">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <!-- One cell: the map fills it, and overlays sit on top, aligned to the corners. -->
    <Grid>
        <mapsui:MapControl x:Name="MapControl"/>

        <!-- Top left: back to the previous screen -->
        <Button Content="← Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"/>

        <!-- Top right: zoom controls -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Spacing="4">
            <Button Classes="map" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in (+)"/>
            <Button Classes="map" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out (−)"/>
            <Button Classes="map" Content="⌂" Command="{Binding ShowWholeWorldCommand}" ToolTip.Tip="Whole world (Home)"/>
        </StackPanel>

        <!-- Top center: instructions while picking a location -->
        <Border Classes="overlay" HorizontalAlignment="Center" VerticalAlignment="Top" IsVisible="{Binding IsPicking}">
            <TextBlock Text="Double-click the map to choose the game's location"/>
        </Border>

        <!-- Bottom center: the chosen point and OK, once something is chosen. Raised above the
             corner overlays so they don't collide in a narrow window. -->
        <Border Classes="overlay" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,64"
                IsVisible="{Binding CanConfirm}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas, monospace">
                    <Run Text="Selected:"/>
                    <Run Text="{Binding CoordinatesText}" FontWeight="Bold"/>
                </TextBlock>
                <Button Content="OK" Command="{Binding ConfirmCommand}" MinWidth="64"
                        HorizontalContentAlignment="Center" Classes="accent"/>
            </StackPanel>
        </Border>

        <!-- Bottom left: where the map is centered, and what's under the pointer -->
        <Border Classes="overlay" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <StackPanel>
                <TextBlock Text="{Binding Readout}" FontFamily="Consolas, monospace"/>
                <TextBlock Text="{Binding PointerReadout}" FontFamily="Consolas, monospace" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Bottom right: imagery credit (required by the tile provider's terms) -->
        <Border Classes="overlay" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Attribution}" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
