<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             xmlns:views="using:PathFinder.Views"
             x:Class="PathFinder.Views.WaitingView"
             x:DataType="vm:WaitingViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Three dots hopping in turn: something is happening, we're waiting on the others -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#4FC3F7"/>
        </Style>
        <Style Selector="Ellipse.dot.d1">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="Infinite" Easing="SineEaseInOut" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="RenderTransform" Value="translateY(-10px)"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.dot.d2">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.15" IterationCount="Infinite" Easing="SineEaseInOut" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="RenderTransform" Value="translateY(-10px)"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.dot.d3">
            <Style.Animations>
                <Animation Duration="0:0:1.2" Delay="0:0:0.3" IterationCount="Infinite" Easing="SineEaseInOut" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="25%"><Setter Property="RenderTransform" Value="translateY(-10px)"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="translateY(0px)"/><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <StackPanel Width="460" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Message}" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Left" views:Motion.PopDelay="100"/>
        <StackPanel Orientation="Horizontal" Spacing="8" Height="24" views:Motion.EnterDelay="350">
            <Ellipse Classes="dot d1" VerticalAlignment="Bottom"/>
            <Ellipse Classes="dot d2" VerticalAlignment="Bottom"/>
            <Ellipse Classes="dot d3" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBlock Text="{Binding TimeLeft}" views:Motion.EnterDelay="250"/>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding TimeFraction}" Foreground="#4FC3F7"
                     Height="4" MinHeight="4" views:Motion.EnterDelay="300">
            <ProgressBar.Transitions>
                <Transitions><DoubleTransition Property="Value" Duration="0:0:0.25"/></Transitions>
            </ProgressBar.Transitions>
        </ProgressBar>
        <TextBlock Text="{Binding Submissions}" Opacity="0.7" views:Motion.EnterDelay="400"/>
    </StackPanel>
</UserControl>
