<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             xmlns:net="using:PathFinder.Network"
             x:Class="PathFinder.Views.LobbyView"
             x:DataType="vm:LobbyViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>

    <!-- Placeholder layout: the UI owner can restyle this freely; bindings are the contract. -->
    <StackPanel Width="420" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="PathFinder" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>

        <!-- Host / join menu -->
        <StackPanel Spacing="8" IsVisible="{Binding IsInMenu}" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Your name"/>
            <TextBox Text="{Binding PlayerName}" MaxLength="20"/>

            <Button Content="Host a game" Command="{Binding HostCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>

            <TextBlock Text="Or join a game (game code or IP address)" Margin="0,12,0,0"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding JoinAddress}"/>
                <Button Grid.Column="1" Content="Join" Command="{Binding JoinCommand}" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Lobby -->
        <StackPanel Spacing="8" IsVisible="{Binding IsInLobby}">
            <TextBlock Text="Lobby" FontSize="20" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding GameCode, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="Game code:" VerticalAlignment="Center"/>
                <SelectableTextBlock Text="{Binding GameCode}" FontSize="28" FontWeight="Bold" FontFamily="Consolas, monospace"/>
                <Button Content="Copy" Click="CopyGameCode_Click" VerticalAlignment="Center"/>
                <!-- IP fallback as a small info bubble: hover for a tooltip, click for a copyable popup -->
                <Button Content="&#x24D8;" FontSize="16" Padding="6,0" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Opacity="0.6"
                        ToolTip.Tip="{Binding HostAddresses}" AutomationProperties.Name="Other ways to join">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <SelectableTextBlock Text="{Binding HostAddresses}" TextWrapping="Wrap" MaxWidth="320"/>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <!-- No IPv4 game code: the IPs are the only way in, so show them plainly -->
            <SelectableTextBlock Text="{Binding HostAddresses}" TextWrapping="Wrap" Opacity="0.7"
                                 IsVisible="{Binding ShowAddressesDirectly}"/>
            <TextBlock Text="{Binding MapInfo}" IsVisible="{Binding IsHost}" Opacity="0.7" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding MapWarning}" TextWrapping="Wrap" Foreground="#E0A030"
                       IsVisible="{Binding MapWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <TextBlock Text="Players" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ItemsControl ItemsSource="{Binding Players}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <TextBlock Text="{Binding}" Margin="8,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Match settings: only the host picks them -->
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding IsHost}" Margin="0,8,0,0">
                <TextBlock Text="Rounds" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <NumericUpDown Grid.Column="1" Value="{Binding Rounds}" Minimum="{Binding MinRounds}" Maximum="{Binding MaxRounds}"
                               Increment="1" FormatString="0" Margin="0,0,0,6" IsEnabled="{Binding !MatchStarted}"/>
                <TextBlock Grid.Row="1" Text="Seconds per round" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding RoundSeconds}" Minimum="{Binding MinRoundSeconds}"
                               Maximum="{Binding MaxRoundSeconds}" Increment="15" FormatString="0" IsEnabled="{Binding !MatchStarted}"/>

                <!-- Demo spots: fill in Location and Radius; each has a map bundled with the app, so it loads instantly -->
                <TextBlock Grid.Row="2" Text="Presets" VerticalAlignment="Center" Margin="0,6,12,0"/>
                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Presets}" Margin="0,6,0,0"
                              IsEnabled="{Binding !MatchStarted}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="net:DemoMap">
                            <Button Content="{Binding Name}" Margin="0,0,6,6" Padding="8,3" FontSize="12"
                                    Command="{Binding $parent[UserControl].((vm:LobbyViewModel)DataContext).UsePresetCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Location: type coordinates, or open the map to pick them -->
                <TextBlock Grid.Row="3" Text="Location" VerticalAlignment="Center" Margin="0,6,12,0"/>
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,6,0,0" IsEnabled="{Binding !MatchStarted}">
                    <TextBox Text="{Binding Location}" PlaceholderText="Latitude, longitude"/>
                    <Button Grid.Column="1" Content="Pick on map" Command="{Binding PickLocationOnMapCommand}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LocationError}" FontSize="12" Foreground="#C04000"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding LocationError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <TextBlock Grid.Row="5" Text="Radius (m)" VerticalAlignment="Center" Margin="0,6,12,0" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RadiusMeters}" PlaceholderText="Radius" Margin="0,6,0,0"
                         IsEnabled="{Binding !MatchStarted}"/>
            </Grid>
            <CheckBox Content="Practice (solo allowed)" IsChecked="{Binding PracticeMode}"
                      IsVisible="{Binding IsHost}" IsEnabled="{Binding !MatchStarted}"
                      ToolTip.Tip="Lets the host start a competitive match alone. Cloud Navigator still needs two players."/>

            <!-- Cloud Navigator (co-op) placeholder controls: mode (host only) and roles (everyone) -->
            <StackPanel Spacing="6" Margin="0,8,0,0">
                <CheckBox Content="Cloud Navigator mode (co-op: one navigates, one drives)" IsChecked="{Binding NavigatorMode}"
                          IsVisible="{Binding IsHost}" IsEnabled="{Binding !MatchStarted}"/>
                <TextBlock Text="{Binding NavigatorTeam}" TextWrapping="Wrap" Opacity="0.7"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !MatchStarted}">
                    <Button Content="I'll navigate" Command="{Binding BeNavigatorCommand}"/>
                    <Button Content="I'll drive" Command="{Binding BeDriverCommand}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="StartGameButton" Content="{Binding StartButtonText}" Command="{Binding StartMatchCommand}"
                        IsVisible="{Binding IsHost}" IsEnabled="{Binding CanStartMatch}"/>
                <Button Content="Leave" Command="{Binding LeaveCommand}"/>
            </StackPanel>
            <TextBlock Text="Waiting for the host to start the match..." Opacity="0.7"
                       IsVisible="{Binding !IsHost}"/>
            <TextBlock Text="Waiting for at least one more player to join (or tick Practice to play alone)..." Opacity="0.7" TextWrapping="Wrap"
                       IsVisible="{Binding NeedsMorePlayers}"/>
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#E0A030"/>
    </StackPanel>
</UserControl>
