<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             xmlns:views="using:PathFinder.Views"
             x:Class="PathFinder.Views.PlayingView"
             x:DataType="vm:PlayingViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Countdown: smooth bar, and a red heartbeat in the last 10 seconds -->
        <Style Selector="ProgressBar.timer">
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Value" Duration="0:0:0.25"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.4"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ProgressBar.timer.hurry">
            <Setter Property="Foreground" Value="#FF5252"/>
        </Style>
        <Style Selector="TextBlock.timer">
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.4"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.timer.hurry">
            <Setter Property="Foreground" Value="#FF5252"/>
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="scale(1.18)"/></KeyFrame>
                    <KeyFrame Cue="45%"><Setter Property="RenderTransform" Value="scale(1)"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="scale(1)"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Submit breathes once the route reaches the destination, so it's obvious what to do next -->
        <Style Selector="Button.ready">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="RenderTransform" Value="scale(1)"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="RenderTransform" Value="scale(1.08)"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RenderTransform" Value="scale(1)"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto" ClipToBounds="True">
        <!-- Load background image -->
        <Image Source="avares://PathFinder/Assets/placeholderbg.png"
               Grid.Row="0"
               Grid.RowSpan="3"
               Stretch="UniformToFill"/>

        <!-- Header information -->
        <!-- Rows rise in one after another (Motion.EnterDelay, in ms) -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding Title}"
                    FontSize="24"
                    FontWeight="Bold"
                    views:Motion.PopDelay="0"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding Route}" views:Motion.EnterDelay="120"/>
            <TextBlock Text="{Binding MapInfo}" Opacity="0.7" views:Motion.EnterDelay="170"/>
            <TextBlock Text="{Binding HostWarning}" TextWrapping="Wrap" Foreground="#E0A030"
                       IsVisible="{Binding HostWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <StackPanel Spacing="4" views:Motion.EnterDelay="220">
                <TextBlock Text="{Binding TimeLeft}" FontSize="20" HorizontalAlignment="Left"
                           Classes="timer" Classes.hurry="{Binding IsLowOnTime}"/>
                <ProgressBar Classes="timer" Classes.hurry="{Binding IsLowOnTime}"
                             Minimum="0" Maximum="1" Value="{Binding TimeFraction}"
                             Width="280" Height="6" MinHeight="6" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock Text="{Binding Submissions}" Opacity="0.7" views:Motion.EnterDelay="270"/>
            <TextBlock Text="{Binding RouteSummary}" views:Motion.EnterDelay="320"/>
            <TextBlock x:Name="RouteHintText" Text="{Binding RouteHint}" Foreground="#E0A030" TextWrapping="Wrap"
                       IsVisible="{Binding RouteHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- Map -->
        <Canvas x:Name="MapCanvas"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"/>

        <!-- Map data credit (required by the OpenStreetMap licence); hidden for the test grid -->
        <TextBlock Grid.Row="1"
                   Text="{Binding MapAttribution}"
                   IsVisible="{Binding MapAttribution, Converter={x:Static ObjectConverters.IsNotNull}}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="4"
                   FontSize="11"
                   Opacity="0.6"
                   IsHitTestVisible="False"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    views:Motion.EnterDelay="380">
            <Button Content="Submit route"
                    Command="{Binding SubmitRouteCommand}"
                    IsEnabled="{Binding CanSubmitRoute}"
                    Classes.accent="{Binding CanSubmitRoute}"
                    Classes.ready="{Binding CanSubmitRoute}"/>

            <Button Content="Undo"
                    Command="{Binding UndoStreetCommand}"/>

            <Button Content="Clear"
                    Command="{Binding ClearRouteCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
