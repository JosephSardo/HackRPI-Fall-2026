<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             x:Class="PathFinder.Views.PlayingView"
             x:DataType="vm:PlayingViewModel">
    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <StackPanel Width="460" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="{Binding Route}"/>
        <TextBlock Text="{Binding TimeLeft}" FontSize="20"/>
        <TextBlock Text="{Binding Submissions}" Opacity="0.7"/>
        <TextBlock Text="The map goes here. For now, submit a made-up path:" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Submit direct path" Command="{Binding SubmitDirectCommand}"/>
            <Button Content="Submit longer path" Command="{Binding SubmitDetourCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
