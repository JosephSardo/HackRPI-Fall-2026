<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             x:Class="PathFinder.Views.PlayingView"
             x:DataType="vm:PlayingViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Styles>
    
    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto" ClipToBounds="True">
        <!-- Load background image -->
        <Image Source="avares://PathFinder/Assets/placeholderbg.png"
               Grid.Row="0"
               Grid.RowSpan="3"
               Stretch="UniformToFill"/>

        <!-- Header information -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding Title}"
                    FontSize="24"
                    FontWeight="Bold"/>

            <TextBlock Text="{Binding Route}"/>
            <TextBlock Text="{Binding MapInfo}" Opacity="0.7"/>
            <TextBlock Text="{Binding HostWarning}" TextWrapping="Wrap" Foreground="#E0A030"
                       IsVisible="{Binding HostWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <TextBlock Text="{Binding TimeLeft}" FontSize="20"/>
            <TextBlock Text="{Binding Submissions}" Opacity="0.7"/>
            <TextBlock Text="{Binding RouteSummary}"/>
            <TextBlock Text="{Binding RouteHint}" Foreground="#E0A030" TextWrapping="Wrap"
                       IsVisible="{Binding RouteHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- Map -->
        <Canvas x:Name="MapCanvas"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Submit route"
                    Command="{Binding SubmitRouteCommand}"
                    IsEnabled="{Binding CanSubmitRoute}"/>

            <Button Content="Undo"
                    Command="{Binding UndoStreetCommand}"/>

            <Button Content="Clear"
                    Command="{Binding ClearRouteCommand}"/>

            <!-- Placeholders from before street selection existed; remove before the demo. -->
            <Button Content="Submit best route"
                    Command="{Binding SubmitBestCommand}"/>

            <Button Content="Submit a longer route"
                    Command="{Binding SubmitLongerCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
