<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PathFinder.ViewModels"
             xmlns:sys="using:System"
             x:Class="PathFinder.Views.PlayingView"
             x:DataType="vm:PlayingViewModel"
             Background="#1d1945"
             TextElement.Foreground="#d3eaff">

    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- The countdown: huge, and in the last 10 seconds it throbs once a second.
             (Font size + opacity: Avalonia 12 has no animator for RenderTransform.) -->
        <Style Selector="TextBlock.timer.critical">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="FontSize" Value="124"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="35%">
                        <Setter Property="FontSize" Value="96"/>
                        <Setter Property="Opacity" Value="0.7"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="FontSize" Value="96"/>
                        <Setter Property="Opacity" Value="0.7"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    
    <!-- Placeholder layout: restyle freely; bindings are the contract. -->
    <Grid Margin="16" RowDefinitions="Auto,*,Auto" ClipToBounds="True">
        <!-- Load background image -->
        <Image Source="avares://PathFinder/Assets/night-sky-bg.png"
               Grid.Row="0"
               Grid.RowSpan="3"
               Stretch="UniformToFill"/>

        <!-- Header information -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding Title}"
                    FontSize="24"
                    FontWeight="Bold"/>

            <TextBlock Text="{Binding Route}"/>
            <TextBlock Text="{Binding MapInfo}" Opacity="0.7"/>
            <TextBlock Text="{Binding HostWarning}" TextWrapping="Wrap" Foreground="#E0A030"
                       IsVisible="{Binding HostWarning, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <!-- Draining time bar: changes colour with the countdown -->
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding TimePercent}" Height="14"
                         Foreground="{Binding TimerBrush}" Background="#33FFFFFF" CornerRadius="7"/>
            <TextBlock Text="{Binding Submissions}" Opacity="0.7"/>
            <TextBlock Text="{Binding RouteSummary}"/>
            <TextBlock Text="{Binding RouteHint}" Foreground="#E0A030" TextWrapping="Wrap"
                       IsVisible="{Binding RouteHint, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>

        <!-- Big countdown, top right -->
        <TextBlock Grid.Row="0" Classes="timer" Classes.critical="{Binding IsCritical}"
                   Text="{Binding SecondsLeft}" Foreground="{Binding TimerBrush}"
                   FontSize="96" FontWeight="Black"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,24,0"/>

        <!-- Map -->
        <Canvas x:Name="MapCanvas"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"/>

        <!-- Map data credit (required by the OpenStreetMap licence); hidden for the test grid -->
        <TextBlock Grid.Row="1"
                   Text="{Binding MapAttribution}"
                   IsVisible="{Binding MapAttribution, Converter={x:Static ObjectConverters.IsNotNull}}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="4"
                   FontSize="11"
                   Opacity="0.6"
                   IsHitTestVisible="False"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="Submit route"
                    Command="{Binding SubmitRouteCommand}"
                    IsEnabled="{Binding CanSubmitRoute}"/>

            <Button Content="Undo"
                    Command="{Binding UndoStreetCommand}"/>

            <Button Content="Clear"
                    Command="{Binding ClearRouteCommand}"/>
        </StackPanel>

    </Grid>
</UserControl>
